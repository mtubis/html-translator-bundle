parameters:
    level: max
    paths:
        - src
        - tests
        - config
    excludePaths:
        - tests/Functional/var (?)
    tmpDir: var/phpstan
    checkUninitializedProperties: true
    checkImplicitMixed: true
    checkBenevolentUnionTypes: true
    reportPossiblyNonexistentGeneralArrayOffset: true
    reportAnyTypeWideningInVarTag: true
    treatPhpDocTypesAsCertain: false
    # Written by tests/phpstan-container.php (run by `composer stan` and the PostToolUse hook). phpstan-symfony reads
    # it before bootstrapFiles run, so it cannot be generated from within PHPStan. On a fresh clone, run
    # `composer stan` (not vendor/bin/phpstan directly) so the file exists.
    symfony:
        containerXmlPath: var/phpstan/container.xml
